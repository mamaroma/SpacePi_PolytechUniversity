# ─── Telegram credentials ─────────────────────────────────────
# Get these from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_CHANNEL=PolyTechUniverseBot

# ─── Database ─────────────────────────────────────────────────
# SQLite (default, works out of the box):
DATABASE_URL=sqlite:///./telemetry.db

# PostgreSQL example (optional):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/telemetry

# Telethon session storage:
# 1) Local/file-based session:
# TELETHON_SESSION_NAME=./telemetry_session
# 2) Hosted/Render session via environment variable:
TELETHON_SESSION_STRING=

# ─── API security ─────────────────────────────────────────────
# Token for the POST /api/collect/run endpoint (leave empty to disable auth)
COLLECT_TOKEN=

# JWT secret for user authentication (change to a random string in production!)
JWT_SECRET=change-me-to-a-long-random-string

# API key for the binary packet ingest endpoint (POST /api/ingest/binary).
# Used by ground stations, SDR pipelines and MCUs to push raw telemetry.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
INGEST_API_KEY=spacepi-ingest-key-CHANGE-ME

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=*

# ─── TLE data for orbit propagation ───────────────────────────
# Format: one line per satellite, normalized name (spaces/hyphens → _)
# Example for Polytech_Universe-3:
TLE_POLYTECH_UNIVERSE_3_1=1 57166U 23090T   26090.50000000  .00000000  00000-0  00000-0 0  9999
TLE_POLYTECH_UNIVERSE_3_2=2 57166  97.5000  90.0000 0001000   0.0000 360.0000 15.00000000    00

# Example for Polytech_Universe-5:
# TLE_POLYTECH_UNIVERSE_5_1=...
# TLE_POLYTECH_UNIVERSE_5_2=...

# ─── Automatic server-side collect ────────────────────────────
AUTO_COLLECT_ENABLED=false
AUTO_COLLECT_INTERVAL_MINUTES=30

# ─── VKontakte cross-post (новости → группа) ──────────────────
# Группа: https://vk.ru/kaoiii
# Нужен USER access token (не community), у аккаунта — права редактора группы.
# Права токена: wall, photos, offline
# Получение (Implicit Flow): создайте standalone-приложение на https://dev.vk.com
# и откройте в браузере (подставьте APP_ID):
# https://oauth.vk.com/authorize?client_id=APP_ID&display=page&redirect_uri=https://oauth.vk.com/blank.html&scope=wall,photos,offline&response_type=token&v=5.199
# Из адресной строки blank.html скопируйте access_token=...
VK_ACCESS_TOKEN=
VK_GROUP_SCREEN_NAME=kaoiii
# Либо числовой id группы без минуса:
# VK_GROUP_ID=
VK_CROSSPOST_ENABLED=true
PUBLIC_SITE_URL=https://poly-space.ru
